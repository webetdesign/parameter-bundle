{
    "name": "webetdesign/parameter-bundle",
    "version": "7.x-dev",
    "type": "symfony-bundle",
    "license": "proprietary",
    "authors": [
        {
            "name": "Web&Design",
            "homepage": "https://www.webetdesign.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "doctrine/common": "^2.11 || ^3.0",
        "doctrine/doctrine-bundle": "^1.12 || ^2.0 || ^3.0",
        "doctrine/orm": "^2.6.4 || ^3.0",
        "symfony/config": "^6.4",
        "symfony/dependency-injection": "^6.4",
        "symfony/doctrine-bridge": "^6.4",
        "symfony/form": "^6.4",
        "symfony/options-resolver": "^6.4",
        "symfony/twig-bridge": "^6.4",
        "symfony/twig-bundle": "^6.4",
        "symfony/validator": "^6.4"
    },
    "require-dev": {
        "roave/security-advisories": "dev-master",
        "sonata-project/admin-bundle": "^3.79|^4.0",
        "symfony/filesystem": "^6.4",
        "symfony/phpunit-bridge": "^6.4",
        "symfony/yaml": "^6.4"
    },
    "suggest": {
        "sonata-project/admin-bundle": "Add parameter admin interface"
    },
    "config": {
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "WebEtDesign\\ParameterBundle\\": "src/"
        }
    }
}
